---
import SiteHeader from '../components/layout/SiteHeader';
import FightClub from '../components/FightClub';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Deadlock Fight Club Generator</title>
    <meta
      name="description"
      content="Generate random 1v1 Fight Club matches for Deadlock with fair item loadouts. Practice and improve your skills!"
    />
  </head>
  <body>
    <SiteHeader client:load />
    <main>
      <FightClub client:load />
    </main>
  </body>
</html>
